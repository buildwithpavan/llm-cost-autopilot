# --- Database ---
DATABASE_URL=postgres://lca:lca@localhost:5432/lca

# --- Server ---
PORT=8080
LCA_LOG_LEVEL=info

# --- Bootstrap ---
# Used exactly once at first boot to mint the initial admin API key.
# Rotate immediately after bootstrap and remove from env.
LCA_BOOTSTRAP_ADMIN_KEY=change-me-to-a-long-random-string

# --- Providers (optional; adapters use env or a secret store) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=lca-api

# --- Testing / development ---
# When set, mock provider fails the first request with the given error class.
# Used by quickstart Scenario 5.
LCA_MOCK_FAIL_FIRST=
